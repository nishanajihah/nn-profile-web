# Environment Variables for nn-profile-web
# Make a copy of this file as .env.local and fill in your credentials

# Spotify API credentials
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
VITE_SPOTIFY_ARTIST_ID=your_spotify_artist_id_here
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/api/auth/callback/spotify

# GitHub API
VITE_GITHUB_TOKEN=your_github_personal_access_token

# Email Service (for contact form)
# Options: emailjs, formspree, or custom
VITE_EMAIL_SERVICE=formspree
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_USER_ID=your_emailjs_user_id
VITE_FORMSPREE_FORM_ID=your_formspree_form_id

# Ko-fi
VITE_KOFI_USERNAME=your_kofi_username
