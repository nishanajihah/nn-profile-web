# Environment Variables for nn-profile-web (v2.0.0)
# Make a copy of this file as .env.development or .env.production

# Spotify API credentials
PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
PUBLIC_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
PUBLIC_SPOTIFY_ARTIST_ID=your_spotify_artist_id_here
PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:5173/api/auth/callback/spotify

# GitHub Personal Access Token for API requests (Server-side only)
GITHUB_TOKEN=your_github_personal_access_token

# Ko-fi Support Configuration
PUBLIC_KOFI_USERNAME=yourkofiname

# Email Service Configuration
PUBLIC_EMAIL_SERVICE=mailgun
PUBLIC_MAILGUN_ENDPOINT=/api/mailgun
PUBLIC_CONTACT_EMAIL=your@email.com

# Mailgun API credentials (server-side only)
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain.com
