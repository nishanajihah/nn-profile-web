# Environment Variables for nn-profile-web
# Make a copy of this file as .env.local and fill in your credentials

# Spotify API credentials
PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
PUBLIC_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
PUBLIC_SPOTIFY_ARTIST_ID=your_spotify_artist_id_here
PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:5173/api/auth/callback/spotify

# GitHub Personal Access Token for API requests
# GitHub API (Server-side only - do NOT use PUBLIC_ prefix)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token

# Environment Configuration
NODE_ENV=development

# Ko-fi Support Configuration
PUBLIC_KOFI_USERNAME=yourkofiname

# Email Service Configuration
PUBLIC_EMAIL_SERVICE=mailgun
PUBLIC_MAILGUN_ENDPOINT=/api/mailgun
PUBLIC_CONTACT_EMAIL=your@email.com

# Mailgun API credentials (server-side only)
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain.com

# Alternative email services
PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
PUBLIC_EMAILJS_USER_ID=your_emailjs_user_id
PUBLIC_FORMSPREE_FORM_ID=your_formspree_form_id
